<?xml version="1.0" encoding="utf-8"?>
<!-- Cinzel (SIL Open Font License 1.1, https://github.com/google/fonts/
     tree/main/ofl/cinzel) - Ueberschriften-/Label-Font im WoW-Gold-Redesign
     (siehe PLAN-JARVIS-APP-REDESIGN.md). Upstream ist eine Variable Font
     (Achse "wght" 400-900); die drei Gewichte hier sind mit
     fontTools.varLib.instancer als statische Instanzen extrahiert, gleiche
     Buendelungs-Logik wie rajdhani.xml. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/cinzel_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/cinzel_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/cinzel_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
