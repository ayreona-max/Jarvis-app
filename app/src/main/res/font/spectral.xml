<?xml version="1.0" encoding="utf-8"?>
<!-- Spectral (SIL Open Font License 1.1, https://github.com/google/fonts/
     tree/main/ofl/spectral) - Fliesstext-Font im WoW-Gold-Redesign (siehe
     PLAN-JARVIS-APP-REDESIGN.md), app-weiter Theme-Default. Cinzel
     (cinzel.xml) wird nur gezielt fuer Ueberschriften/Labels ueberschrieben. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/spectral_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/spectral_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/spectral_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
