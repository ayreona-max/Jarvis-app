<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout statt direkt ScrollView: der Sperrschirm liegt als eigene
     Ebene OBEN drauf, damit er wirklich alles verdeckt, auch waehrend die
     ScrollView noch scrollt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jarvis"
            android:textSize="22sp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sprich mit Jarvis oder tippe eine Nachricht."
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <!-- HUD-Gesicht (14.08.2026, siehe PLAN-JARVIS-HUD-GESICHT.md) -
             zeigt Ruht/Hoert-zu/Denkt-nach/Antwortet, wird von
             MainActivity ueber hudView.setZustand(...) gesteuert. -->
        <com.jarvis.app.HudView
            android:id="@+id/hudView"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no" />

        <!-- Zugangsdaten liegen hinter einem Schalter und sind standardmaessig
             ZU. Sie braucht sie nur einmal je Installation, aber sie stehen
             ganz oben und landen auf jedem Screenshot - und Screenshots sind
             ihr wichtigstes Diagnosewerkzeug (die komplette Health-Sync-Suche
             lief ueber Bildschirmfotos). Beim ersten Start ohne gespeicherte
             Daten klappt der Bereich automatisch auf. -->
        <Button
            android:id="@+id/zugangToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zugangsdaten einblenden"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/zugangBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Server-URL (z. B. https://...ngrok-free.dev)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/accessKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Zugangsschluessel"
                android:inputType="textPassword"
                android:paddingTop="8dp" />

            <EditText
                android:id="@+id/e2eKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Schluessel (E2E) - leer lassen = unverschluesselt"
                android:inputType="textPassword"
                android:paddingTop="8dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nachricht an Jarvis"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/sendButton"
            style="@style/Widget.Jarvis.HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text senden"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/talkButton"
            style="@style/Widget.Jarvis.HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Sprechen"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/cameraButton"
            style="@style/Widget.Jarvis.HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Zeigen / Scannen"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/wakeButton"
            style="@style/Widget.Jarvis.HudButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 &quot;Hey Jarvis&quot; aktivieren"
            android:layout_marginTop="8dp" />

        <!-- v0.31: Standort mitschicken. Bewusst NICHT hinter den
             Zugangsdaten versteckt, sondern gleich sichtbar - sie soll die
             Ortung im Vorbeigehen abstellen koennen, ohne die Berechtigung
             in den Android-Einstellungen zurueckzunehmen. Darunter steht,
             welchen Ort die App gerade kennt: Ohne diese Anzeige waere im
             Alltag nicht pruefbar, ob die Ortung ueberhaupt etwas liefert. -->
        <CheckBox
            android:id="@+id/standortSchalter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="14sp"
            android:text="Standort mitschicken (für Empfehlungen unterwegs)" />

        <TextView
            android:id="@+id/standortInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:text="" />

        <TextView
            android:id="@+id/wakeStatusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:text="" />

        <TextView
            android:id="@+id/answerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:text="" />

        <!-- Nachrichten, die Jarvis von sich aus schickt (Briefings,
             Manus-Ergebnisse). Wird in MainActivity programmatisch
             gefuellt - eine Liste mit wenigen Eintraegen braucht keine
             eigene Listen-Mechanik. -->
        <TextView
            android:id="@+id/postfachTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="4dp"
            android:textSize="18sp"
            android:text="Nachrichten von Jarvis" />

        <LinearLayout
            android:id="@+id/postfachListe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>

    <!-- App-Sperre: undurchsichtig, deckt alles ab. Standardmaessig
         sichtbar - MainActivity blendet sie erst nach erfolgreicher
         Fingerabdruck-/PIN-Pruefung aus. -->
    <LinearLayout
        android:id="@+id/sperrschirm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis ist gesperrt"
            android:textSize="18sp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/entsperrenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entsperren" />
    </LinearLayout>
</FrameLayout>
