<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-weites Theme fuer das Magenta-Redesign (23.08.2026, siehe
         PLAN-JARVIS-APP-REDESIGN.md). Theme.MaterialComponents statt
         Theme.AppCompat, damit MaterialCardView (Kacheln mit
         angeschnittenen Ecken) funktioniert. android:colorBackground
         UND android:windowBackground werden beide gesetzt: der
         Sperrbildschirm (activity_main.xml, sperrschirm) referenziert
         explizit ?android:attr/colorBackground. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorPrimaryDark">@color/jarvis_bg</item>
        <item name="colorAccent">@color/jarvis_accent</item>
        <item name="colorControlActivated">@color/jarvis_accent_bright</item>
        <item name="android:windowBackground">@drawable/jarvis_bg_gradient</item>
        <item name="android:colorBackground">@color/jarvis_bg</item>
        <item name="android:textColorPrimary">@color/jarvis_text_primary</item>
        <item name="android:textColorSecondary">@color/jarvis_text_secondary</item>
        <item name="android:fontFamily">@font/rajdhani</item>
        <item name="fontFamily">@font/rajdhani</item>
    </style>
</resources>
