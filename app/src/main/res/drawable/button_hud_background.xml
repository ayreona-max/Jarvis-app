<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome fuer die vier Haupt-Buttons - flache Outline-Chips ohne
     Ecken-Klammern (16.08.2026, Option B aus dem Mockup-Vergleich,
     siehe PLAN-JARVIS-APP-BUTTONS.md). state_activated zeigt den
     Ein-Zustand von talkButton/wakeButton (kraeftigere Fuellung +
     hellerer Rahmen), state_pressed liefert das Ripple-Feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/jarvis_button_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/jarvis_button_fill_activated" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/jarvis_accent_bright" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/jarvis_button_fill" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/jarvis_accent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
