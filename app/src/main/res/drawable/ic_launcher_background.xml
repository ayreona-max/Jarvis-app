<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-Icon-Hintergrund: dieselbe dunkle Verlaufsflaeche wie der
     App-Untergrund (jarvis_bg_oben -> jarvis_bg, siehe colors.xml und
     activity_main.xml/jarvis_bg_gradient.xml), damit das Launcher-Icon
     zur restlichen App passt. Volle 108x108-Flaeche, da je nach
     Launcher-Maske (Kreis/Quadrat/Squircle) unterschiedlich viel davon
     sichtbar bleibt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="8"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0" android:color="@color/jarvis_bg_oben" />
                <item android:offset="1" android:color="@color/jarvis_bg" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
